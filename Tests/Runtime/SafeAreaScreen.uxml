<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:gf="GameFoundation.Scripts.UIModule.UITK.Utilities" editor-extension-mode="False">
    <!--
        Deliberately identical in shape to SCREEN_UXML_TEMPLATE in ViewCreatorTemplates.cs:
        same xmlns:gf, same <gf:SafeAreaElement>, same attribute spelling. If the UxmlElement
        source generator ever stops registering the element, or the attribute names drift,
        the wizard's generated UXML breaks — and this file breaks with it, here, instead of
        in somebody's new screen.
    -->
    <ui:VisualElement name="safe-area-screen" style="flex-grow: 1;">
        <gf:SafeAreaElement name="safe-area" conform-x="false" apply-mode="Inset" style="flex-grow: 1;">
            <ui:Label name="title" text="Safe area" />
        </gf:SafeAreaElement>
    </ui:VisualElement>
</ui:UXML>
